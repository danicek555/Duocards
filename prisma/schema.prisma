generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  nickname      String         @default("User")
  emailVerified Boolean        @default(true)
  coins         Int            @default(100)
  words         Word[]
  flashcardSets FlashcardSet[]
  aiGenerations AiGeneration[]

  @@map("users")
}

model PendingRegistration {
  id                      Int      @id @default(autoincrement())
  email                   String   @unique
  password                String
  nickname                String
  createdAt               DateTime @default(now())
  verificationCode        String
  verificationCodeExpires DateTime

  @@map("pending_registrations")
}

model FlashcardSet {
  id            Int      @id @default(autoincrement())
  name          String
  userId        Int
  fromLanguage  String?
  toLanguage    String?
  isAIGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  words         Word[]

  @@map("flashcard_sets")
}

model Word {
  id             Int           @id @default(autoincrement())
  word           String
  translation    String
  difficulty     Int           @default(1)
  userId         Int
  flashcardSetId Int?
  pronunciation  String?
  imageId        Int?          @unique
  audioId        Int?          @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardSet   FlashcardSet? @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  image          WordImage?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  audio          WordAudio?    @relation(fields: [audioId], references: [id], onDelete: SetNull)

  @@map("words")
}

model WordImage {
  id        Int      @id @default(autoincrement())
  dataUrl   String   @db.Text
  mimeType  String   @default("image/png")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  word      Word?

  @@map("word_images")
}

model WordAudio {
  id        Int      @id @default(autoincrement())
  dataUrl   String   @db.Text
  mimeType  String   @default("audio/mpeg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  word      Word?

  @@map("word_audio")
}

model AiGeneration {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_generations")
}
