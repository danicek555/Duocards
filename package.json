{
  "name": "duocards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "build:backend": "npm --prefix backend run build",
    "test:coins": "node --import tsx --test src/lib/coinEconomy.test.ts",
    "test:coins:integration": "node --import tsx --test src/lib/coinEconomy.integration.test.ts",
    "test:coins:migration": "tsx scripts/test-coin-migration.mts",
    "test:study": "node --import tsx --test src/lib/studySrs.test.ts",
    "test:study:migration": "tsx scripts/test-study-migration.mts",
    "test:backend": "npm --prefix backend test",
    "build:prod": "prisma migrate deploy && prisma generate && next build",
    "build:vercel": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "delete-users": "npx tsx scripts/delete-users.ts",
    "check-users": "npx tsx scripts/check-users.ts",
    "check-ai-health": "npx tsx scripts/check-ai-health.ts",
    "check-ai-health:skip-image": "SKIP_AI_IMAGE_CHECK=1 npx tsx scripts/check-ai-health.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "7.0.0",
    "@prisma/extension-accelerate": "^3.0.0",
    "@sentry/nextjs": "^10.22.0",
    "@vercel/analytics": "^2.0.1",
    "ably": "^2.21.0",
    "argon2": "^0.44.0",
    "bad-words": "^4.0.0",
    "heic2any": "^0.0.4",
    "next": "15.5.9",
    "openai": "^6.7.0",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "^5.11.0",
    "resend": "^6.1.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.4",
    "prisma": "^7.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}
