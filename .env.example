# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database URLs
DATABASE_URL="your_database_url_here"
POSTGRES_URL="your_postgres_url_here"
PRISMA_DATABASE_URL="your_prisma_database_url_here"

# Email Configuration
RESEND_API_KEY=your_resend_api_key_here
# Verified domain address in Resend (e.g. notifications@duocards.xyz)
FROM_EMAIL=notifications@duocards.xyz

# Google OAuth (Sign in with Google on login page)
# 1. Create credentials at https://console.cloud.google.com/apis/credentials
# 2. OAuth client type: Web application
# 3. Authorized redirect URIs (add both for local + production):
#    - http://localhost:3000/api/auth/google/callback
#    - https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth (Sign in with Facebook on login page)
# 1. Create an app at https://developers.facebook.com/apps/
# 2. Use cases → Authentication and account creation → Permissions → Add "email"
#    (must show "Ready for testing" or login fails with Invalid Scopes: email)
# 3. Facebook Login → Settings → Valid OAuth Redirect URIs:
#    - http://localhost:3000/api/auth/facebook/callback
#    - https://your-domain.com/api/auth/facebook/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Application URLs (no hardcoded fallbacks — set both in production)
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_LIVE_GAME_GUEST_URL=https://live.your-domain.com
NEXT_PUBLIC_API_BASE_URL=/api

# Shared HMAC session secret. Web and backend must use the exact same value.
# Generate a private random value with at least 32 bytes; never commit it.
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Optional shared backend migration. Set both variables to route migrated web
# reads/auth requests through the same-origin Next.js proxy. Omit them to keep
# using the legacy /api routes.
SHARED_BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SHARED_API_BASE_URL=/shared-api
# Optional: set to "vercel" to bypass Cloud Run for all migrated web API calls.
NEXT_PUBLIC_API_BACKEND=

# OpenAI (AI flashcards, chat, images, TTS) — see npm run check-ai-health
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-2

# Ably Realtime
ABLY_API_KEY=your_ably_api_key_here

# Redis (optional) — omit REDIS_URL to use in-memory rate limits; set when you want Redis Cloud / shared limits.
# Use redis:// for plain TCP or rediss:// for TLS (match what Redis Cloud shows for your endpoint).
# ERR_SSL_PACKET_LENGTH_TOO_LONG: rediss:// to a non-TLS port — use redis://, or set REDIS_USE_TLS=false
# (forces rediss→redis) when REDIS_URL is injected from the shell / Vercel with the wrong scheme.
# URL-encode special characters in the password.
# REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
# REDIS_USE_TLS=false
