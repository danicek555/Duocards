# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database URLs
DATABASE_URL="your_database_url_here"
POSTGRES_URL="your_postgres_url_here"
PRISMA_DATABASE_URL="your_prisma_database_url_here"

# Email Configuration
RESEND_API_KEY=your_resend_api_key_here
# Verified domain address in Resend (e.g. notifications@duocards.xyz)
FROM_EMAIL=notifications@duocards.xyz

# Application URLs (no hardcoded fallbacks — set both in production)
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_LIVE_GAME_GUEST_URL=https://live.your-domain.com
NEXT_PUBLIC_API_BASE_URL=/api
# Ably Realtime
ABLY_API_KEY=your_ably_api_key_here
